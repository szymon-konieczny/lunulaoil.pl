STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-v2

# Paynow (mBank) payments — provider is only registered when the keys are set
PAYNOW_API_KEY=
PAYNOW_SIGNATURE_KEY=
# https://api.paynow.pl (prod) / https://api.sandbox.paynow.pl (sandbox)
PAYNOW_API_URL=https://api.sandbox.paynow.pl
# IMPORTANT: in the Paynow merchant panel (per environment!) set the
# notification / webhook URL to:
#   https://<backend-domain>/hooks/payment/paynow_paynow
# (prod: https://api.lunulaoil.pl/hooks/payment/paynow_paynow)
# Without it, orders are only created when the buyer returns to the storefront
# after paying; the paynow-reconcile-orders job sweeps up the rest.

# Instagram comment-to-DM bot
ENABLE_INSTAGRAM_BOT=false
IG_APP_ID=
IG_APP_SECRET=
IG_VERIFY_TOKEN=
IG_PAGE_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
IG_OAUTH_REDIRECT_URI=
STOREFRONT_URL=https://lunulaoil.pl

# Storefront cache revalidation (must match REVALIDATE_SECRET in storefront)
REVALIDATE_SECRET=
