{
  "name": "lunula-storefront",
  "version": "1.0.3",
  "private": true,
  "author": "Szymon Konieczny <simon@progrise.dev>",
  "description": "Storefront for the Lunula Botanique shop (lunulaoil.pl), backed by Medusa v2",
  "scripts": {
    "postinstall": "sh patches/fix-medusa-sdk-localstorage.sh",
    "dev": "next dev --turbopack -p 8000",
